#include <iostream>
#include <fstream>
#include <vector>
#include <string>

using namespace std;

// BankAccount class utilizing Object-Oriented Programming (OOP)
class BankAccount {
private:
    int accountNumber;
    string name;
    double balance;

public:
    BankAccount() : accountNumber(0), name(""), balance(0.0) {}
    BankAccount(int accNum, string accName, double initialBalance) {
        accountNumber = accNum;
        name = accName;
        balance = initialBalance;
    }

    // Getter methods
    int getAccountNumber() const { return accountNumber; }
    string getName() const { return name; }
    double getBalance() const { return balance; }

    // Transaction methods
    void deposit(double amount) {
        if (amount > 0) {
            balance += amount;
            cout << "Deposit successful! New Balance: $" << balance << "\n";
        } else {
            cout << "Invalid deposit amount!\n";
        }
    }

    void withdraw(double amount) {
        if (amount > 0 && amount <= balance) {
            balance -= amount;
            cout << "Withdrawal successful! Remaining Balance: $" << balance << "\n";
        } else {
            cout << "Insufficient balance or invalid amount!\n";
        }
    }

    void displayAccount() const {
        cout << "Acc No: " << accountNumber 
             << " | Name: " << name 
             << " | Balance: $" << balance << "\n";
    }
};

// File handling functions
vector<BankAccount> loadAccounts() {
    vector<BankAccount> accounts;
    ifstream inFile("bank_data.txt");
    if (!inFile) return accounts;

    int accNum;
    string name;
    double balance;

    while (inFile >> accNum) {
        inFile.ignore();
        getline(inFile, name);
        inFile >> balance;
        accounts.push_back(BankAccount(accNum, name, balance));
    }
    inFile.close();
    return accounts;
}

